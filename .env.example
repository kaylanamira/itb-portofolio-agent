POSTGRES_DB=itb_portofolio
POSTGRES_USER=itb_admin
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql+psycopg://itb_admin:your_password_here@localhost:5432/itb_portofolio

# For psql CLI
PGHOST=localhost
PGPORT=5432
PGDATABASE=itb_portofolio
PGUSER=itb_admin
PGPASSWORD=your_password_here
SIX_COOKIE='your_six_cookie_here'
SIX_NIM='your_nim'

# SEED ADMIN LOGIN
ADMIN_PASSWORD=

# Model and Provider configuration
LLM_PROVIDER='groq' # Options: groq, google, openai, anthropic

# Groq (Default)
GROQ_MODEL='llama-3.3-70b-versatile'
GROQ_API_KEY='gsk_xxx'

# Google Gemini
GOOGLE_MODEL='gemini-1.5-pro'
GOOGLE_API_KEY='AIzaSyxxx'

# OpenAI
OPENAI_MODEL='gpt-4o-mini'
OPENAI_API_KEY='sk-proj-xxx'

# Anthropic
ANTHROPIC_MODEL='claude-3-5-sonnet-latest'
ANTHROPIC_API_KEY='sk-ant-xxx'
OPENROUTER_API_KEY='sk-or-v1-xxx'

# Optional Task-to-Model Overrides (Defaults shown below)
# INTENT_MODEL='meta-llama/llama-3-8b-instruct:free'
# REWRITER_MODEL='google/gemma-2-9b-it:free'
# PLANNING_MODEL='meta-llama/llama-3.3-70b-instruct:free'
# LINKING_MODEL='meta-llama/llama-3-8b-instruct:free'
# SQL_GEN_MODEL='meta-llama/llama-3.3-70b-instruct:free'
# VALIDATION_MODEL='google/gemma-2-9b-it:free'
# REASONING_MODEL='google/gemma-2-9b-it:free'
# SYNTHESIS_MODEL='google/gemma-2-9b-it:free'
# CLARIFICATION_MODEL='google/gemma-2-9b-it:free'

# --- Rate limit spreading: route heavy vs light tasks to different free-tier providers ---
# Heavy (SQL gen, planning) → paid or different free bucket
# SQL_GEN_MODEL='openai/gpt-4o-mini'
# PLANNING_MODEL='openai/gpt-4o-mini'
# Light tasks → spread across google/meta free tiers
# INTENT_MODEL='google/gemma-2-9b-it:free'
# REWRITER_MODEL='google/gemma-2-9b-it:free'
# LINKING_MODEL='meta-llama/llama-3.1-8b-instruct:free'
# VALIDATION_MODEL='meta-llama/llama-3.1-8b-instruct:free'
# REASONING_MODEL='google/gemma-2-9b-it:free'
# SYNTHESIS_MODEL='google/gemma-2-9b-it:free'

# --- Local model via Ollama (when ready) ---
# 1. Install: brew install ollama
# 2. Pull:    ollama pull qwen2.5-coder:7b   (~4GB, best for SQL on Apple Silicon)
# 3. Serve:   ollama serve
# 4. Set in .env:
# HEAVY_LLM_PROVIDER=ollama
# HEAVY_LLM_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Tradeoffs vs GPT/Claude: no rate limits, full privacy, but weaker reasoning on complex SQL.